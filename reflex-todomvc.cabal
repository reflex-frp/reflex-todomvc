cabal-version: 3.4
-- The cabal-version field refers to the version of the .cabal specification,
-- and can be different from the cabal-install (the tool) version and the
-- Cabal (the library) version you are using. As such, the Cabal (the library)
-- version used must be equal or greater than the version stated in this field.
-- Starting from the specification version 2.2, the cabal-version field must be
-- the first thing in the cabal file.

-- Initial package description 'frontend' generated by
-- 'cabal init'. For further documentation, see:
--   http://haskell.org/cabal/users-guide/
--
-- The name of the package.
name: reflex-todomvc

-- The package version.
-- See the Haskell package versioning policy (PVP) for standards
-- guiding when and how versions should be incremented.
-- https://pvp.haskell.org
-- PVP summary:     +-+------- breaking API changes
--                  | | +----- non-breaking API additions
--                  | | | +--- code changes with no API change
Version:            0.1.0.0

-- A short (one-line) description of the package.
synopsis: Functional Reactive TodoMVC

-- A longer description of the package.
description: An implementation of the TodoMVC specification using the Reflex-DOM functional reactive DOM library

-- The license under which the package is released.
license: BSD-3-Clause
license-file: LICENSE

-- The package author(s).
author: Ryan Trinkle

-- An email address to which users can send suggestions, bug reports, and patches.
maintainer: ryan.trinkle@gmail.com

stability: Experimental

category: FRP

-- build-type: Custom
build-type: Simple

-- Extra source files to be distributed with the package, such as examples, or a tutorial module.
-- extra-source-files:

flag warp
  description: Build relfex-todomvc-warp
  default: True

flag webkitgtk
  description: Build relfex-todomvc-webkitgtk
  default: False

flag wkwebview
  description: Build relfex-todomvc-wkwebview
  default: False

flag webkit2gtk
  description: Use WebKit2 version of WebKitGTK.
  default: False

flag strict
  description: Build with options, such as -Werror, which are inconvenient for development but good for CI
  default: False
  manual: True

--custom-setup
--  setup-depends:    base
--                  , Cabal
--                  -- , cabal-macosx

library
  -- Modules exported by the library.
  exposed-modules:  Reflex.TodoMVC

  -- Modules included in this library but not exported.
  -- other-modules:

  -- LANGUAGE extensions used by modules in this package.
  -- other-extensions:

  -- Other library packages from which modules are imported.
  build-depends:    base
                  , reflex
                  , file-embed
                  , ghcjs-dom
                  , reflex-dom-core
                  , reflex-dom
                  , containers
                  , text

  -- Directories containing source files.
  hs-source-dirs: src

  ghc-prof-options: -fprof-auto
  ghc-options:  -Wall -fwarn-tabs -funbox-strict-fields -O2

  if os(ios)
    build-depends:
      jsaddle-wkwebview
    exposed-modules:
      Reflex.IOS

executable reflex-todomvc
  build-depends:    base
                  , ghcjs-dom
                  , reflex-dom
                  , reflex-todomvc

  hs-source-dirs: src-bin
  main-is: main.hs

  ghc-prof-options: -fprof-auto
  ghc-options: -threaded -Wall -fwarn-tabs -funbox-strict-fields -O2

executable reflex-todomvc-warp
  build-depends:    base
                  , ghcjs-dom
                  , jsaddle-warp
                  , reflex-todomvc

  hs-source-dirs: src-bin
  main-is: warp.hs

  ghc-prof-options: -fprof-auto
  ghc-options: -threaded -Wall -fwarn-tabs -funbox-strict-fields -O2

  if !flag(warp) || (impl(ghcjs) || arch(javascript))
    buildable: False

executable reflex-todomvc-webkitgtk
  build-depends:    base
                  , reflex-todomvc

  hs-source-dirs: src-bin
  main-is: webkitgtk.hs

  ghc-prof-options: -fprof-auto
  ghc-options: -threaded -Wall -fwarn-tabs -funbox-strict-fields -O2

  if flag(webkit2gtk)
    build-depends:
      jsaddle-webkit2gtk
  else
    build-depends:
      jsaddle-webkitgtk

  if !flag(webkitgtk) || (impl(ghcjs) || arch(javascript)) || os(ios)
    buildable: False

executable reflex-todomvc-wkwebview
  build-depends:    base
                  , jsaddle-wkwebview
                  , reflex-todomvc

  hs-source-dirs: src-bin
  main-is: wkwebview.hs

  ghc-prof-options: -fprof-auto
  ghc-options: -threaded -Wall -fwarn-tabs -funbox-strict-fields -O2

  if !flag(wkwebview) || !(os(osx) || os(ios)) || (impl(ghcjs) || arch(javascript))
    buildable: False

benchmark bench-builder-all
  type:             exitcode-stdio-1.0

  build-depends:    base
                  , reflex-todomvc
                  , reflex
                  , reflex-dom
                  , containers
                  , mtl
                  , lens
                  , ghcjs-dom
                  , criterion
                  , dependent-sum
                  , transformers
                  , ref-tf
                  , text

  hs-source-dirs:   src-bin
  main-is:          bench.hs

  ghc-options: -threaded -Wall -fwarn-tabs -funbox-strict-fields -O2

  if os(ios) || (impl(ghcjs) || arch(javascript))
    buildable: False
